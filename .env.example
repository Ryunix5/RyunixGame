# Server (packages/server) — copy to .env and adjust as needed

# Port the server listens on (default 3001)
PORT=3001

# Only needed if the client is hosted on a different origin than the server,
# e.g. CORS_ORIGIN=https://games.example.com (comma-separated for several).
# Leave unset when the server serves the built client itself.
# CORS_ORIGIN=

# Client (packages/client) — only when the server lives on another origin
# VITE_SERVER_URL=https://api.example.com
