{
    "name": "@ryunix/server",
    "version": "0.1.0",
    "main": "src/index.ts",
    "scripts": {
        "dev": "nodemon src/index.ts",
        "prebuild": "npm run build --prefix ../shared",
        "build": "tsc",
        "postbuild": "copyfiles -u 1 content/**/* dist",
        "start": "node dist/index.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage"
    },
    "dependencies": {
        "@ryunix/shared": "file:../shared",
        "cors": "^2.8.5",
        "dotenv": "^16.4.1",
        "express": "^5.2.1",
        "socket.io": "^4.7.4",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.11",
        "@types/node": "^20.11.16",
        "@types/uuid": "^9.0.8",
        "copyfiles": "^2.4.1",
        "jest": "^29.7.0",
        "nodemon": "^3.0.3",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.2"
    }
}
